@@ -0,0 +1,50 @@
+package fr.xephi.authme.service;
+
+import fr.xephi.authme.data.TempbanManager;
+import fr.xephi.authme.data.captcha.LoginCaptchaManager;
+
+import javax.inject.Inject;
+
+/**
+ * Records failed password attempts for every login surface.
+ *
+ * <p>Keeping this accounting in one service prevents graphical pre-join login from bypassing
+ * the captcha and temporary-ban counters used by the regular command login flow.</p>
+ */
+public class LoginFailureTracker {
+
+    @Inject
+    private LoginCaptchaManager loginCaptchaManager;
+
+    @Inject
+    private TempbanManager tempbanManager;
+
+    LoginFailureTracker() {
+    }
+
+    /**
+     * Records one failed password comparison.
+     *
+     * @param address source IP address; may be absent before a connection has exposed it
+     * @param normalizedName lowercase player name
+     * @return the protection state after recording the failure
+     */
+    public LoginFailureResult recordFailure(String address, String normalizedName) {
+        loginCaptchaManager.increaseLoginFailureCount(normalizedName);
+
+        boolean hasAddress = address != null && !address.isBlank();
+        if (hasAddress) {
+            tempbanManager.increaseCount(address, normalizedName);
+        }
+        return new LoginFailureResult(
+            loginCaptchaManager.isCaptchaRequired(normalizedName),
+            hasAddress && tempbanManager.shouldTempban(address));
+    }
+
+    public boolean isCaptchaRequired(String normalizedName) {
+        return loginCaptchaManager.isCaptchaRequired(normalizedName);
+    }
+
+    public record LoginFailureResult(boolean captchaRequired, boolean tempbanRequired) {
+    }
+}

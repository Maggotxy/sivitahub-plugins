{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui", "ground", "fixed", "on_shelf"],
        "model": {
          "type": "minecraft:model",
          "model": "originalrpg:item/forged_ranger_trident"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:model",
        "model": "originalrpg:item/forged_ranger_trident_in_hand"
      },
      "on_true": {
        "type": "minecraft:model",
        "model": "originalrpg:item/forged_ranger_trident_throwing"
      }
    }
  }
}
